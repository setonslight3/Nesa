<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required from Android 13 onwards. NESA asks for it in context, and
         degrades to in-app reminders when it is refused. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Not exported: only NESA's own notifications may trigger it. -->
        <receiver
            android:name=".ActivityActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.nesa.action.COMPLETE" />
                <action android:name="com.nesa.action.LATER" />
                <action android:name="com.nesa.action.SKIP" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
